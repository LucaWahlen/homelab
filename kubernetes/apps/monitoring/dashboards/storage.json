    {
      "id": 13,
      "type": "table",
      "title": "Volumes",
      "description": "Every PersistentVolumeClaim. Size is the requested size, the limit the volume was created with; Used, Free and Used % are measured on the volume's filesystem by the kubelet, so they are only known while a pod mounts the volume. A volume that isn't mounted still takes its full Size on the data disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
