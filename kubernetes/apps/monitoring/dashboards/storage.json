  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Data disk allocated",
      "description": "Share of the OpenEBS LVM data disk taken by volumes. Volumes are thick LVM volumes, so each takes its full size up front.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "(sum(lvm_vg_total_size_bytes{job=\"openebs-lvm\"}) - sum(lvm_vg_free_size_bytes{job=\"openebs-lvm\"})) / sum(lvm_vg_total_size_bytes{job=\"openebs-lvm\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Data disk size",
      "description": "Size of the LVM volume group backing all volumes (opentofu vm_data_disk_size).",
