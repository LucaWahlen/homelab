k3s_version: "v1.30.5+k3s1"

argocd_version: "v2.13.2"

# Same repo this file lives in, used for the ArgoCD app-of-apps bootstrap.
# Use an https:// URL if the repo is public - ArgoCD needs no credentials
# for that. A private repo needs a deploy key registered with ArgoCD
# separately (not covered by this repo) if you use git@ SSH form instead.
git_repo_url: "https://github.com/youruser/homelab.git"
git_revision: "main"
apps_path: "apps/applications"
