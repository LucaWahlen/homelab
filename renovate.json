{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "terraform": {
    "rangeStrategy": "bump"
  },
  "kubernetes": {
    "managerFilePatterns": ["(^|/)manifests/[^/]+\\.ya?ml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "kubectl pinned in devcontainer, kept in sync with k3s (client skew)",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["dl\\.k8s\\.io/release/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/bin"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "helm CLI pinned in devcontainer",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["helm-v(?<currentValue>\\d+\\.\\d+\\.\\d+)-linux"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "kustomize CLI pinned in devcontainer",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["kustomize%2Fv(?<currentValue>\\d+\\.\\d+\\.\\d+)/kustomize_v"],
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "ksops CLI pinned in devcontainer",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["kustomize-sops/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/ksops"],
      "depNameTemplate": "viaduct-ai/kustomize-sops",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "sops CLI pinned in devcontainer",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["getsops/sops/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/sops"],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "opencode pinned in devcontainer",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "matchStrings": ["VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+) curl -fsSL https://opencode\\.ai/install"],
      "depNameTemplate": "sst/opencode",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "k3s version pinned in ansible group vars",
      "managerFilePatterns": ["/inventory/group_vars/all\\.yml(\\.example)?$"],
      "matchStrings": ["k3s_version:\\s*\"v(?<currentValue>\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\+k3s(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "ksops image in argocd kustomization helm values",
      "managerFilePatterns": ["(^|/)manifests/kustomization\\.yaml$"],
      "matchStrings": ["image:\\s*viaductoss/ksops:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "viaductoss/ksops",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "kubectl and k3s in one PR so client/cluster skew stays within +/-1 minor",
      "matchPackageNames": ["kubernetes/kubernetes", "k3s-io/k3s"],
      "groupName": "kubernetes"
    },
    {
      "description": "devcontainer CLI tooling in one PR",
      "matchPackageNames": [
        "helm/helm",
        "kubernetes-sigs/kustomize",
        "viaduct-ai/kustomize-sops",
        "getsops/sops",
        "sst/opencode"
      ],
      "groupName": "devcontainer tooling"
    }
  ]
}
