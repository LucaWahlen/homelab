{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "terraform": {
    "rangeStrategy": "bump"
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|\\/)manifests\\/deployment\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "pinned devcontainer tool versions (ARG + inline renovate comment)",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\nARG \\S+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "k3s version pinned in ansible group vars",
      "managerFilePatterns": [
        "//inventory/group_vars/all\\.yml(\\.example)?$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*\"v(?<currentValue>\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "ksops image in argocd kustomization helm values",
      "managerFilePatterns": [
        "/(^|/)manifests/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*viaductoss/ksops:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "viaductoss/ksops",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "helm v4 breaks kustomize's helmCharts rendering (see kustomization.yaml); stay on v3 until explicitly migrated",
      "matchDepNames": ["helm/helm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Do not track kubernetes apiVersion strings (cluster is pinned older than latest k8s)",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "kubectl and k3s in one PR so client/cluster skew stays within +/-1 minor",
      "matchPackageNames": [
        "kubernetes/kubernetes",
        "k3s-io/k3s"
      ],
      "groupName": "kubernetes"
    },
    {
      "description": "devcontainer CLI tooling in one PR",
      "matchPackageNames": [
        "helm/helm",
        "kubernetes-sigs/kustomize",
        "viaduct-ai/kustomize-sops",
        "getsops/sops",
        "opentofu/opentofu",
        "FiloSottile/age",
        "sst/opencode"
      ],
      "groupName": "devcontainer tooling"
    }
  ]
}