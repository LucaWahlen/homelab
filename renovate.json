{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:dockerfileVersions", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "platformAutomerge": true,
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s version in ansible group vars",
      "managerFilePatterns": ["/^ansible/inventory/group_vars/all\\.yml$/"],
      "matchStrings": ["k3s_version: \"(?<currentValue>v\\S+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Debian 13 (trixie) genericcloud image pinned in opentofu",
      "managerFilePatterns": ["/^opentofu/proxmox-vm/variables\\.tf$/"],
      "matchStrings": [
        "https://cloud\\.debian\\.org/images/cloud/trixie/(?<currentValue>\\d{8}-\\d+)/debian-13-genericcloud-amd64-\\d{8}-\\d+\\.qcow2"
      ],
      "autoReplaceStringTemplate": "https://cloud.debian.org/images/cloud/trixie/{{{newValue}}}/debian-13-genericcloud-amd64-{{{newValue}}}.qcow2",
      "depNameTemplate": "debian/trixie-genericcloud-amd64",
      "datasourceTemplate": "custom.debian-cloud-image",
      "versioningTemplate": "regex:^(?<major>\\d{8})-(?<minor>\\d+)$"
    }
  ],
  "customDatasources": {
    "debian-cloud-image": {
      "defaultRegistryUrlTemplate": "https://cloud.debian.org/images/cloud/trixie/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "Flux system manifests are managed by the native flux manager",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["kubernetes/flux-system/gotk-components.yaml"],
      "enabled": false
    },
    {
      "description": "Keep the Flux CLI pin and the in-cluster components in sync",
      "matchPackageNames": ["fluxcd/flux2"],
      "groupName": "flux"
    },
    {
      "description": "Merge non-major updates once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Providers come from the OpenTofu registry, matching the lock files",
      "matchDatasources": ["terraform-provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "required_version is checked against OpenTofu, but Renovate would track Terraform",
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "matchFileNames": [".devcontainer/**"],
      "groupName": "devcontainer"
    },
    {
      "description": "Cluster and kubectl together, one minor at a time",
      "matchPackageNames": ["k3s-io/k3s", "kubernetes/kubernetes"],
      "groupName": "kubernetes",
      "separateMultipleMinor": true,
      "automerge": false
    },
    {
      "description": "Debian cloud image: the release directory is the version, newest wins",
      "matchDatasources": ["custom.debian-cloud-image"],
      "extractVersion": "^(?<version>\\d{8}-\\d+)/?$",
      "groupName": "debian-cloud-image",
      "automerge": true
    }
  ]
}
